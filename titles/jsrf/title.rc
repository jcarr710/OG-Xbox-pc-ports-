/* Icon, version information and manifest for jsrf.exe. */
#include <winver.h>
#include "version.h"

1 ICON "res/icon.ico"
1 24 "res/app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     TITLE_VERSION_MAJOR, TITLE_VERSION_MINOR, TITLE_VERSION_PATCH, 0
PRODUCTVERSION  TITLE_VERSION_MAJOR, TITLE_VERSION_MINOR, TITLE_VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Jet Set Radio Future loader for Windows"
            VALUE "FileVersion",      TITLE_VERSION_STR
            VALUE "InternalName",     "jsrf"
            VALUE "OriginalFilename", "jsrf.exe"
            VALUE "ProductName",      TITLE_PRODUCT
            VALUE "ProductVersion",   TITLE_VERSION_STR
            VALUE "LegalCopyright",   "Copyright (C) 2026 jcarr710. GNU GPL v2 or later."
            VALUE "Comments",         "Fan project, not affiliated with SEGA. Needs your own copy of the game."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
